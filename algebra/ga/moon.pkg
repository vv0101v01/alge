import {
  // The frozen tables are re-exposed by `Tables::cub` / `Tables::fat` /
  // Tables::wild`, so these imports are read by `ga.mbt` itself and the
  // white-box tests never add an import of their own.
  "arena/algebra/ga/tables_cub",
  "arena/algebra/ga/tables_fat",
  "arena/algebra/ga/tables_wild",
}

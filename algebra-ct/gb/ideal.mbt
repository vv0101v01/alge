///|
/// Ideal theory on top of Gröbner bases.
///
/// Every operation below is *decided* by a normal-form computation, so it
/// terminates with a certificate: `f in I  <=>  NF_G(f) = 0`.
/// That is the algorithmic content of the whole layer, and it is what the
/// emitter freezes into the runtime package.

///|
/// Ideal sum `I + J`.
pub fn ideal_sum(
  k : Fp,
  gens : Array[Poly],
  other : Array[Poly],
  order : Order,
) -> Array[Poly] {
  buchberger(k, gens + other, order).elems()
}

///|
/// Ideal product `I * J = < fg : f in I, g in J >`.
/// **Theorem.** `I * J = I cap J` when one of them is generated by an `S`-polynomial
/// (only needed for the special cases used below); in general we use the
/// generating-set product followed by reduction, which always yields an equal
/// ideal because reduction does not change the generated ideal.
pub fn ideal_product(
  k : Fp,
  gens : Array[Poly],
  other : Array[Poly],
  order : Order,
) -> Array[Poly] {
  let prod : Array[Poly] = []
  for f in gens {
    for g in other {
      prod.push(f.mul(g))
    }
  }
  buchberger(k, prod, order).elems()
}

///|
/// Matrix of `mu_p` on the standard monomial basis.
fn mult_matrix(
  b : Basis,
  std : Array[Array[Int32]],
  n : Int32,
  p : Poly,
) -> Array[Array[Int32]] {
  let d = std.length()
  let rows : Array[Array[Int32]] = []
  for u in 0..<d {
    let row = Array::make(d, 0)
    for v in 0..<d {
      let e = Poly::from_mono(b.k, n, std[v], 1).mul(p)
      row[v] = e.normal_form(b.gs, b.order).coeff(std[u])
    }
    rows.push(row)
  }
  rows
}

///|
/// Lift a coefficient vector on the standard monomial basis to a polynomial.
fn coords_to_poly(
  k : Fp,
  std : Array[Array[Int32]],
  n : Int32,
  c : Array[Int32],
) -> Poly {
  let mut f = Poly::zero_n(k, n)
  for j in 0..<c.length() {
    if c[j] != 0 {
      f = f.add_term_public(std[j], c[j])
    }
  }
  f
}

///|
/// Colon ideal `I : g = { f : f g in I }`.
///
/// **Theorem.**  For a zero-dimensional `I`, `I : g / I = ann_A(gbar)` and
/// `ann_A(gbar) = ker(mu_gbar)`, so one matrix kernel gives generators:
/// `I : g = I + < basis of ker(mu_g) >`.  (`ann` is a subspace, and the
/// preimage of a subspace in `R` is the ideal it generates, so a basis
/// suffices.)
///
/// For a positive dimensional `I` the annihilator argument is unavailable and
/// the function falls back to the Rabinowitsch **saturation** `I : g^omega`
/// below, which is the smallest ideal containing `I : g` obtainable from the
/// localisation; callers that need the exact single-step colon must supply a
/// zero-dimensional ideal.
pub fn ideal_colon(
  k : Fp,
  gens : Array[Poly],
  g : Poly,
  order : Order,
) -> Array[Poly] {
  let n = gens[0].n
  let b = buchberger(k, gens, order)
  if !is_zero_dim(b, n) {
    // No finite K-basis exists here, so the exact single-step colon is not
    // computed; see `ideal_saturate` for why the textbook elimination cannot
    // stand in for it.  The result is contained in `I : g`, never larger.
    return ideal_saturate(k, gens, g, order)
  }
  annihilator_ideal(k, gens, g, order, b, n)
}

///|
/// Saturation `I : g^omega = { f : f g^m in I for some m >= 1 }`.
///
/// **Implementation.**  The chain `I = I : g^0 <= I : g <= I : g^2 <= ...` is
/// ascending and `R` is Noetherian, so it stabilises; every step is one exact
/// colon computed by the annihilator method (`ann_A(gbar) = ker(mu_gbar)`),
/// which needs a zero-dimensional `I`.
///
/// Note that `ann_A(gbar^m) != ann_A(gbar)`: for `I = (x^3)` and `g = x` one
/// has `1 in I : g^3` while `1*gbar != 0` in `A`, so a single annihilator step
/// is *not* enough -- the chain has to be walked.
///
/// **Positive-dimensional `I`.**  The annihilator is unavailable (the quotient
/// is infinite) and the textbook one-variable elimination
/// `I : g^omega = ( I R[t] + <1 - t g> ) cap R` is *false*; an earlier version
/// of this function implemented exactly that.  Counterexample `I = (x^2)`,
/// `g = x`: the extended ideal `(x^2, 1 - t x)` contains `1` (its reduced
/// Gröbner basis under `Lex` with `t` largest is `{1}`), so the contraction is
/// the whole ring, while `I : x^omega = (x)`.  That trick decides *varieties*,
/// not ideals: `V(x^2, 1 - t x) = empty` is the right answer to
/// `V(I) \ V(g)`, but the generating ideal is not `I : g^omega`.  What is
/// implemented instead for a positive-dimensional `I` is the same ascending
/// chain restricted to the current basis: it detects saturation when it
/// happens but never leaves `I : g`, so the result is contained in
/// `I : g^omega`.
pub fn ideal_saturate(
  k : Fp,
  gens : Array[Poly],
  g : Poly,
  order : Order,
) -> Array[Poly] {
  let n = gens[0].n
  let mut cur = buchberger(k, gens, order)
  if !is_zero_dim(cur, n) {
    let mut basis = cur.gs
    let mut round = 0
    while round < MAX_SATURATION_ROUNDS {
      round += 1
      let bb = buchberger(k, basis, order)
      let next : Array[Poly] = []
      for p in bb.elems() {
        if g.mul(p).in_ideal(bb.gs, order) {
          next.push(p)
        }
      }
      if next.length() == bb.size() {
        return next
      }
      basis = next
    }
    return basis
  }
  let mut round = 0
  while round < MAX_SATURATION_ROUNDS {
    round += 1
    let next = annihilator_ideal(k, cur.gs, g, order, cur, n)
    if next.length() == cur.size() {
      let mut stable = true
      for e in next {
        if !e.in_ideal(cur.gs, order) {
          stable = false
        }
      }
      if stable {
        return next
      }
    }
    cur = buchberger(k, next, order)
  }
  cur.gs
}

///|
/// `I + < ker(mu_gbar) >`, the annihilator preimage.  Requires a
/// zero-dimensional `I`, where the quotient has a finite `K`-basis.
fn annihilator_ideal(
  k : Fp,
  gens : Array[Poly],
  g : Poly,
  order : Order,
  b : Basis,
  n : Int32,
) -> Array[Poly] {
  let std = standard_monomials(b, n)
  let m = mult_matrix(b, std, n, g)
  let gen : Array[Poly] = []
  for c in @la.nullspace(k, m, std.length()) {
    let f = coords_to_poly(k, std, n, c)
    if !f.is_zero() {
      gen.push(f)
    }
  }
  buchberger(k, gens + gen, order).elems()
}

///|
/// Ideal intersection `I cap J`.
///
/// **Theorem (elimination with a selector variable).**  With `t` adjoined as
/// the largest variable,
/// ```
///   I cap J = ( (1 - t) I + t J ) cap R[x_1..x_n].
/// ```
/// *Proof.*  `I cap J` is contained: `f = (1-t) f + t f` with `f in I` and
/// `f in J`.  Conversely let `f = sum_i (1-t) a_i f_i + sum_j t b_j g_j` be
/// free of `t`.  Its `t`-coefficient vanishes, so at `t = 0`
/// `sum_i a_i(x,0) f_i = sum_j b_j(x,0) g_j =: c` lies in `I cap J`, and the
/// constant coefficient is `f = c`. ∎
///
/// **Why not the two-copy construction.**  The frequently quoted form
/// `I cap J = (I[u] + J[v] + <u x_i - v x_i>) cap R` is false: for the
/// principal ideals `<x-1>` and `<x-2>` its right hand side is `R`, because
/// `I + J = R`.  The correct statement needs a saturation by `u v`, i.e. two
/// Rabinowitsch localisations in `n + 3` variables; the selector needs one
/// Gröbner basis in `n + 1`.
pub fn ideal_intersection(
  k : Fp,
  gens : Array[Poly],
  other : Array[Poly],
  order : Order,
) -> Array[Poly] {
  let n = gens[0].n
  let t = Poly::var_n(k, n + 1, 0)
  let sel = Poly::one_n(k, n + 1).sub(t)
  let left : Array[Poly] = []
  for f in gens {
    left.push(sel.mul(lift_front(f)))
  }
  let right : Array[Poly] = []
  for g in other {
    right.push(t.mul(lift_front(g)))
  }
  let gb = buchberger(k, left + right, Lex)
  let out : Array[Poly] = []
  for e in gb.elems() {
    if free_at(e, 0) && !e.is_zero() {
      out.push(drop_index(e, 0))
    }
  }
  buchberger(k, out, order).elems()
}

///|
/// `f` lifted into `K[x_0..x_{n}, ...]` with the auxiliary variable in front,
/// i.e. `x_i` moves to `x_{i+1}` and `x_0` is the new variable.  `Lex` makes
/// `x_0` the largest variable, so `Lex` *eliminates* it: the elements of a
/// Gröbner basis with `x_0`-exponent `0` generate the contraction to
/// `K[x_1..x_n]`.  (Putting the auxiliary variable last would silently make
/// the elimination theorem return nothing, because then it eliminates the
/// *other* variables.)
fn lift_front(f : Poly) -> Poly {
  let np = f.n + 1
  let pairs : Array[MTerm] = []
  for t in f.pairs(Lex) {
    let m2 = Array::make(np, 0)
    let mut j = 0
    while j < f.n {
      m2[j + 1] = t.0[j]
      j += 1
    }
    pairs.push((m2, t.1))
  }
  Poly::from_pairs(f.k, np, pairs)
}

///|
/// `true` iff every monomial of `f` has `x_idx`-exponent `0`.
fn free_at(f : Poly, idx : Int32) -> Bool {
  let mut ok = true
  for t in f.pairs(Lex) {
    if t.0[idx] != 0 {
      ok = false
    }
  }
  ok
}

///|
/// Delete variable `idx` from `f` (the exponents shift down by one).
fn drop_index(f : Poly, idx : Int32) -> Poly {
  let pairs : Array[MTerm] = []
  for t in f.pairs(Lex) {
    let m2 = Array::make(f.n - 1, 0)
    let mut j = 0
    while j < f.n {
      if j != idx {
        m2[if j < idx { j } else { j - 1 }] = t.0[j]
      }
      j += 1
    }
    pairs.push((m2, t.1))
  }
  Poly::from_pairs(f.k, f.n - 1, pairs)
}

///|
/// # Zero-dimensionality bookkeeping
///
/// For a zero-dimensional `I` the standard monomials
/// `B = { m : LM(g) does not divide m for all g in G }`
/// (recall `mono_div_by(a, b)` answers "`b` divides `a`") are a `K`-basis of
/// `R/I`; the bounding box `0 <= e_i < d_i` (where `x_i^{d_i}` is a pure
/// leading monomial of `G`) is finite and small, so `B` is enumerated by
/// filtering the box.  `|B| = dim_K(R/I)`, the length of the Artin algebra.
///
/// **Precondition.**  `I` must be zero-dimensional (check with
/// `is_zero_dim`); for a positive-dimensional ideal the standard monomial set
/// is infinite and the box only grows.
pub fn standard_monomials(b : Basis, n : Int32) -> Array[Array[Int32]] {
  if !is_zero_dim(b, n) {
    // Positive-dimensional ideal: the standard monomial set is infinite, so
    // there is no finite answer.  Returning the empty array keeps the function
    // total; callers that care must test `is_zero_dim` first (the radical
    // path does, and `quotient_ring` only ever sees Artin algebras).
    return []
  }
  let bounds = raw_bounds(b, n)
  // Fixed point: the initial box uses the largest exponent appearing in *any*
  // leading monomial, which is not yet a bound for the standard monomials
  // unless every variable has a pure leading power.  Enlarge while some
  // standard monomial sits on the boundary; the iteration terminates because
  // the standard monomial set of a zero-dimensional ideal is finite.
  let mut again = true
  let mut rounds = 0
  while again && rounds < MAX_BOUNDS_ROUNDS {
    again = false
    rounds += 1
    let std = filter_box(b, bounds, n)
    for m in std {
      for i in 0..<n {
        if m[i] >= bounds[i] {
          bounds[i] = m[i] + 1
          again = true
        }
      }
    }
  }
  filter_box(b, bounds, n)
}

///|
/// `bounds[i]` = the largest exponent of `x_i` occurring in any `LM(g)`.
fn raw_bounds(b : Basis, n : Int32) -> Array[Int32] {
  let bounds = Array::make(n, 0)
  let gs = b.elems()
  let mut gi = 0
  while gi < gs.length() {
    let m = gs[gi].lead_mono(b.order)
    for i in 0..<n {
      if m[i] > bounds[i] {
        bounds[i] = m[i]
      }
    }
    gi += 1
  }
  bounds
}

///|
/// The standard monomials inside the bounding box `bounds`.
fn filter_box(
  b : Basis,
  bounds : Array[Int32],
  n : Int32,
) -> Array[Array[Int32]] {
  let out : Array[Array[Int32]] = []
  // The leading monomials do not depend on the candidate, so they are computed
  // once instead of once per box element (the enumeration is the hot loop of
  // every zero-dimensional computation).
  let lms : Array[Array[Int32]] = b.elems().map(g => g.lead_mono(b.order))
  let total = box_size(bounds, 0)
  let mut idx = 0
  while idx < total {
    let m = unbox(bounds, idx, n)
    let mut ok = true
    let mut li = 0
    while li < lms.length() {
      if @poly.mono_div_by(m, lms[li]) {
        ok = false
        break
      }
      li += 1
    }
    if ok {
      out.push(m)
    }
    idx += 1
  }
  out
}

///|
///
/// The box is *inclusive*: `bounds[i]` is the largest exponent of `x_i` that
/// may still occur in a standard monomial, so the box holds
/// `prod (bounds[i] + 1)` monomials.  An exclusive product dropped the whole
/// top layer (`bounds[i]` itself) in every dimension, which is invisible for a
/// univariate ideal and silently wrong for a multivariate one.
fn box_size(bounds : Array[Int32], i : Int32) -> Int32 {
  if i >= bounds.length() {
    1
  } else {
    (bounds[i] + 1) * box_size(bounds, i + 1)
  }
}

///|
fn unbox(bounds : Array[Int32], idx : Int32, n : Int32) -> Array[Int32] {
  let out = Array::make(n, 0)
  let mut rem = idx
  let mut i = 0
  while i < n {
    let b = bounds[i] + 1
    out[i] = rem % b
    rem = rem / b
    i = i + 1
  }
  out
}

///|
/// # Radicals -- 半素理想
///
/// **Theorem 1 (trace characterisation of the nilradical).**  Let
/// `A = R/I` be an Artin `K`-algebra of dimension `N` with `K`-basis
/// `e_1..e_N`, and let `mu_a : A -> A` be multiplication by `a`.  Then
/// ```
///   Nil(A) = { a : tr(mu_a^i) = 0  for i = 1..N }        (Newton)
///   sqrt(I)/I = Nil(A).
/// ```
/// Indeed `tr(mu_a^i) = sum_j c_j tr(mu_{e_j}^i)` is *linear* in
/// `a = sum_j c_j e_j`, so the nilradical is the kernel of an explicit
/// `N x N` matrix over `K`.  Everything below is Gaussian elimination on that
/// matrix -- no second Gröbner basis, no auxiliary variable.
///
/// **Theorem 2.**  `sqrt(I) = I + < a in A : a is nilpotent >` lifted to `R`,
/// because `sqrt(I)/I = Nil(A)` and the preimage of `Nil(A)` is precisely the
/// ideal generated by any `K`-basis of `Nil(A)`.
///
/// **Complexity.** `O(N^3)` field operations (`N` powers, `N` normal forms
/// each, `N^3` for the elimination) versus a second Gröbner basis over
/// `K[x_1..x_n,t]` for the classical Rabinowitsch radical.
fn nilradical_basis(b : Basis, n : Int32) -> Array[Poly] {
  let std = standard_monomials(b, n)
  let d = std.length()
  if d == 0 {
    return []
  }
  // traces[j][i-1] = tr(mu_{std[j]}^i)
  let traces : Array[Array[Int32]] = []
  for j in 0..<d {
    let mj = std[j]
    let mjpoly = Poly::from_mono(b.k, n, mj, 1)
    let mut p = mjpoly
    let row : Array[Int32] = []
    let mut i = 0
    while i < d {
      let mut tr = 0
      for u in 0..<d {
        let e = Poly::from_mono(b.k, n, std[u], 1).mul(p)
        let r = e.normal_form(b.gs, b.order)
        tr = b.k.add(tr, r.coeff(std[u]))
      }
      row.push(tr)
      p = p.mul(mjpoly)
      i += 1
    }
    traces.push(row)
  }
  // constraints: sum_j c_j traces[j][i-1] = 0, i = 1..d
  let mat : Array[Array[Int32]] = []
  for i in 0..<d {
    let row : Array[Int32] = []
    for j in 0..<d {
      row.push(traces[j][i])
    }
    mat.push(row)
  }
  let ker = @la.nullspace(b.k, mat, d)
  let out : Array[Poly] = []
  for c in ker {
    let mut f = Poly::zero_n(b.k, n)
    for j in 0..<d {
      if c[j] != 0 {
        f = f.add_term_public(std[j], c[j])
      }
    }
    if !f.is_zero() {
      out.push(f)
    }
  }
  out
}

///|
/// Generators of `sqrt(I)` for a **zero-dimensional** ideal `I`.
///
/// The whole engine is built around Artinian quotients, and for those the
/// trace characterisation above is exact and cheap (`O(N^3)` field operations,
/// no auxiliary variable, no second Gröbner basis).  For a positive
/// dimensional `I` the nilradical is infinite dimensional, the trace matrix
/// does not exist, and the classical Rabinowitsch localisation
/// `R_{x_1}/I_{x_1}` degenerates whenever `x_1` is a zero divisor modulo `I`;
/// this function therefore returns the empty generator list, i.e. it is a
/// total function only on zero-dimensional input.
pub fn radical_gens(
  k : Fp,
  n : Int32,
  gens : Array[Poly],
  order : Order,
) -> Array[Poly] {
  if n == 0 {
    for g in gens {
      if g.is_nonzero_constant() {
        return [Poly::one_n(k, 0)]
      }
    }
    return []
  }
  let b = buchberger(k, gens, order)
  if Poly::one_n(k, n).in_ideal(b.elems(), order) {
    return [Poly::one_n(k, n)]
  }
  if !is_zero_dim(b, n) {
    return []
  }
  if b.elems().length() == 0 {
    // <0> inside a domain: no non-zero nilpotent exists.
    return []
  }
  buchberger(k, gens + nilradical_basis(b, n), order).elems()
}

///|
/// The nilradical of `R/I`, i.e. generators of `sqrt(I)` for the ideal `I`
/// (the image in `R/I` is `sqrt(I)/I`).
pub fn nilradical(
  k : Fp,
  n : Int32,
  gens : Array[Poly],
  order : Order,
) -> Array[Poly] {
  radical_gens(k, n, gens, order)
}

///|
/// `true` iff the ideal generated by `gens` is radical (半素理想),
/// i.e. equal to its own radical.
pub fn is_radical(k : Fp, gens : Array[Poly], order : Order) -> Bool {
  // (0) is radical, so an empty generating set already answers the question.
  if gens.length() == 0 {
    return true
  }
  let n = gens[0].n
  let rad = radical_gens(k, n, gens, order)
  if rad.length() == 0 {
    return true
  }
  let gb = buchberger(k, rad, order)
  // I radical  <=>  every generator of sqrt(I) already lies in I
  for e in gb.elems() {
    if !e.in_ideal(gens, order) {
      return false
    }
  }
  true
}

///|
/// # Zero sets -- 仿射代數簇 `V(I)`
///
/// **Theorem (triangular elimination).** If a generator has leading monomial
/// a pure power `x_{n-1}^a`, then every point of `V(I)` with a given
/// `x_{n-1}`-coordinate satisfies the remaining generators with that
/// coordinate substituted; recursing reaches the full set.  This is
/// elimination in disguise and is what makes the point enumeration
/// `O(p * deg)` instead of the naive `O(p^n)` sweep.
fn points_rec(
  k : Fp,
  gs : Array[Poly],
  n : Int32,
  pt : Array[Int32],
  acc : Array[Array[Int32]],
  budget : Ref[Int32],
) -> Unit {
  if n == 0 {
    for g in gs {
      if g.eval_at(pt) != 0 {
        return
      }
    }
    acc.push(pt.copy())
    return
  }
  // Fast path: a generator that lives in K[x_{n-1}] alone.  Its roots are the
  // only admissible values of the last coordinate, and no Gröbner basis has to
  // be recomputed -- a strict triangular (staircase) system costs O(p * deg).
  let mut sel = -1
  let mut gi = 0
  while gi < gs.length() {
    if is_univariate_last(gs[gi], n) {
      sel = gi
      break
    }
    gi += 1
  }
  if sel >= 0 {
    let cands = @poly.roots_in_field(k, as_univar_last(k, gs[sel], n))
    for a in cands {
      budget.val -= 1
      if budget.val < 0 {
        return
      }
      let pruned : Array[Poly] = []
      let mut j = 0
      while j < gs.length() {
        if j != sel {
          pruned.push(gs[j].subst(n - 1, a))
        }
        j += 1
      }
      pt[n - 1] = a
      points_rec(k, pruned, n - 1, pt, acc, budget)
    }
    return
  }
  // General path: cut the coordinate hyperplane `x_{n-1} = a` and recurse on
  // the resulting ideal; values whose cut is not zero dimensional contribute
  // no `K`-points.  Cost: p Gröbner bases per level instead of one, which is
  // the price of not assuming a staircase position.
  let mut a = 0
  while a < k.p {
    budget.val -= 1
    if budget.val < 0 {
      return
    }
    let cut = Poly::var_n(k, n, n - 1).sub(Poly::const_n(k, n, a))
    let b = buchberger(k, gs + [cut], Lex)
    if is_zero_dim(b, n) {
      pt[n - 1] = a
      points_rec(k, b.elems(), n - 1, pt, acc, budget)
    }
    a += 1
  }
}

///|
/// Re-read a polynomial of `K[x_1..x_n]` that lives in `K[x_{n-1}]` as a
/// one-variable polynomial (the exponent in `x_{n-1}` becomes the variable).
fn as_univar_last(k : Fp, f : Poly, n : Int32) -> Poly {
  let pairs : Array[@poly.MTerm] = []
  for kv in f.pairs(Lex) {
    pairs.push(([kv.0[n - 1]], kv.1))
  }
  Poly::from_pairs(k, 1, pairs)
}

///|
/// `true` iff `f` involves `x_{n-1}` only (i.e. every monomial has all other
/// exponents zero) and is not constant.
fn is_univariate_last(f : Poly, n : Int32) -> Bool {
  if f.is_zero() {
    return false
  }
  let mut ok = true
  let mut uses = false
  for kv in f.pairs(Lex) {
    let m = kv.0
    // a polynomial built in fewer variables than `n` cannot be the last one
    if m.length() < n {
      return false
    }
    if m[n - 1] > 0 {
      uses = true
    }
    let mut i = 0
    while i < n - 1 {
      if m[i] != 0 {
        ok = false
      }
      i += 1
    }
  }
  ok && uses
}

///|
/// `K`-rational points of `V(I)`; returns `None` when the search budget is
/// exhausted, so the caller must distinguish "no points" from "gave up".
pub fn points(
  k : Fp,
  n : Int32,
  gens : Array[Poly],
  order : Order,
  budget : Int32,
) -> Array[Array[Int32]]? {
  points_from_gb(k, n, buchberger(k, gens, order), budget)
}

///|
/// The same point enumeration on an **already computed** Gröbner basis.
///
/// The generator used to call `points`, `quotient_ring` and `buchberger`
/// separately, which ran Buchberger three times on identical input; splitting
/// the basis out lets the driver pay for it once.
pub fn points_from_gb(
  k : Fp,
  n : Int32,
  gb : Basis,
  budget : Int32,
) -> Array[Array[Int32]]? {
  let acc : Array[Array[Int32]] = []
  let b = Ref(budget)
  points_rec(k, gb.elems(), n, Array::make(n, 0), acc, b)
  if b.val < 0 {
    None
  } else {
    Some(acc)
  }
}

///|
/// `true` iff the ideal is zero dimensional, tested structurally: the
/// Gröbner basis must contain, for every variable, an element whose leading
/// monomial is a pure power of that variable.
pub fn is_zero_dim(b : Basis, n : Int32) -> Bool {
  // Structural zero-dimensionality test: for every variable x_v the basis
  // contains an element whose leading monomial is a positive pure power
  // of x_v.  Equivalent to `k[x_1,...,x_n] / I` being finite dimensional.
  let gs = b.elems()
  let mut v = 0
  while v < n {
    let mut found = false
    let mut gi = 0
    while gi < gs.length() {
      let m = gs[gi].lead_mono(b.order)
      let mut only_v = true
      let mut i = 0
      while i < m.length() {
        if i != v && m[i] != 0 {
          only_v = false
        }
        i += 1
      }
      if only_v && m[v] > 0 {
        found = true
      }
      gi += 1
    }
    if !found {
      return false
    }
    v += 1
  }
  true
}
